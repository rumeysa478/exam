// ==========================================
// OnboardingScreen.js - Adım Adım Tanıtım Ekranı Örneği
// ==========================================

import { useState } from 'react';
import {
  SafeAreaView,
  StatusBar,
  Text,
  TouchableOpacity,
  View,
} from 'react-native';

// 1. ADIMLAR LİSTESİ (STEPS)
// Her bir ekranda gösterilecek başlık (title) ve açıklama (description) bilgilerini içeren sabit dizi.
const STEPS = [
  {
    title: 'Welcome to the React Native Course',
    description:
      'You will learn core components, navigation, and state management step by step.',
  },
  {
    title: 'Discover Core Components',
    description:
      'Practice building layouts with View, Text, Image, and more.',
  },
  {
    title: 'Kick Off with Expo',
    description:
      'Run `expo start` to launch the project and test on your device in real time.',
  },
];

export default function OnboardingScreen() {
  
  // 2. STATE (DURUM) TANIMLAMASI
  // step: O an hangi adımda olduğumuzu tutan indeks numarası (0, 1 veya 2). Başlangıç 0.
  const [step, setStep] = useState(0);
  
  // 3. KONTROL DEĞİŞKENİ: Kullanıcı son adımda mı? (true / false döner)
  const lastStep = step === STEPS.length - 1; // 2 === 3 - 1 (Yani step 2 olduğunda true olur)

  // 4. SONRAKİ ADIMA GEÇİŞ / YENİDEN BAŞLATMA FONKSİYONU
  const handleNext = () => {
    // Eğer son adımda ise, butona basınca başa (0. adıma) dön
    if (lastStep) {
      setStep(0);
      return;
    }
    // Son adımda değilse, bir sonraki adıma geçmek için step değerini 1 artır
    setStep((prev) => prev + 1);
  };

  return (
    // SafeAreaView: Çentikli ekranlar için güvenli alan sağlar (#0f172a koyu lacivert arkaplan)
    <SafeAreaView style={{ flex: 1, backgroundColor: '#0f172a' }}>
      
      {/* StatusBar: Telefonun üst bildirim çubuğundaki saat/pil simgelerini açık renk (light) yapar */}
      <StatusBar barStyle="light-content" />
      
      {/* Ana Kapsayıcı: justifyContent: 'space-between' ile üst kısımdaki yazıları ve alt kısımdaki butonu ekranın en üstüne ve en altına iter */}
      <View style={{ flex: 1, justifyContent: 'space-between', padding: 24 }}>
        
        {/* ÜST BÖLÜM: Adım Sayacı, Başlık ve Açıklama */}
        <View style={{ gap: 16 }}>
          {/* Adım Göstergesi (Örn: Step 1 / 3) */}
          <Text style={{ color: '#38bdf8', fontSize: 16, fontWeight: '600' }}>
            Step {step + 1} / {STEPS.length}
          </Text>
          
          {/* DİNAMİK BAŞLIK: O anki 'step' indeksine göre STEPS dizisinden başlığı çeker */}
          <Text style={{ color: '#f8fafc', fontSize: 30, fontWeight: '700' }}>
            {STEPS[step].title}
          </Text>
          
          {/* DİNAMİK AÇIKLAMA: O anki 'step' indeksine göre açıklamayı çeker */}
          <Text style={{ color: '#cbd5f5', lineHeight: 22 }}>
            {STEPS[step].description}
          </Text>
        </View>
        
        {/* ALT BÖLÜM: Bilgilendirme metni ve Devam Et / Yeniden Başlat Butonu */}
        <View style={{ gap: 12 }}>
          
          {/* KOŞULLU RENDER (Sadece son adımda ise bu uyarı metni görünür!) */}
          {lastStep && (
            <Text style={{ color: '#94a3b8', textAlign: 'center' }}>
              You’re ready! Restart the flow any time you need a refresher.
            </Text>
          )}
          
          {/* ETKİLEŞİMLİ BUTON (TouchableOpacity) */}
          <TouchableOpacity
            onPress={handleNext}
            activeOpacity={0.8}
            style={{
              paddingVertical: 16,
              borderRadius: 12,
              // KOŞULLU STİL: Son adımda ise yeşil (#22c55e - Restart), diğer adımlarda mavi (#38bdf8 - Continue) olur
              backgroundColor: lastStep ? '#22c55e' : '#38bdf8',
              alignItems: 'center',
            }}
          >
            {/* Buton Metni: Son adımda 'Restart', diğer adımlarda 'Continue' yazar */}
            <Text style={{ color: '#0f172a', fontWeight: '700' }}>
              {lastStep ? 'Restart' : 'Continue'}
            </Text>
          </TouchableOpacity>
          
        </View>
      </View>
    </SafeAreaView>
  );
}
