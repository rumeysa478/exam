// ==========================================
// SearchableList.js - Arama Çubuğu ve FlatList Filtreleme Örneği
// ==========================================

import { useMemo, useState } from 'react';
import { FlatList, SafeAreaView, Text, TextInput, View } from 'react-native';

// 1. HAM DERS LİSTESİ (LESSONS)
const LESSONS = [
  { id: '1', title: 'Intro to React Native' },
  { id: '2', title: 'Working with Expo' },
  { id: '3', title: 'Navigation Basics' },
  { id: '4', title: 'State Management' },
  { id: '5', title: 'Performance Tips' },
];

export default function SearchableList() {
  
  // 2. STATE (DURUM) TANIMLAMASI
  const [query, setQuery] = useState(''); // Kullanıcının arama çubuğuna yazdığı metni tutar (Başlangıç boş)

  // 3. USEMEMO İLE PERFORMANSLI FİLTRELEME (Çok Önemli Sınav Konusu!)
  const filteredLessons = useMemo(() => {
    const lowered = query.toLowerCase(); // Büyük/küçük harf duyarlılığını önlemek için aramayı küçük harfe çeviriyoruz
    
    // LESSONS dizisini filtrele: Ders başlığında aranan ifade (lowered) geçiyorsa listeye dahil et
    return LESSONS.filter((lesson) =>
      lesson.title.toLowerCase().includes(lowered)
    );
  }, [query]); // Bağımlılık dizisi: Sadece 'query' (arama metni) değiştiğinde filtreleme yeniden çalışır.

  return (
    // SafeAreaView: Çentikli ekranlar için güvenli alan sağlar (#f8fafc açık gri arkaplan)
    <SafeAreaView style={{ flex: 1, backgroundColor: '#f8fafc' }}>
      <View style={{ flex: 1, padding: 24, gap: 16 }}>
        
        {/* Başlık */}
        <Text style={{ fontSize: 22, fontWeight: '700', color: '#0f172a' }}>
          Search the lesson archive
        </Text>
        
        {/* 4. TEXTINPUT (Arama Çubuğu) */}
        <TextInput
          value={query}
          onChangeText={setQuery}                      // Yazıldıkça 'query' state'ini günceller
          placeholder="Search lessons..."
          returnKeyType="search"                       // Klavyedeki onay/enter tuşunun simgesini 'arama' (magnifying glass) yapar
          style={{
            borderWidth: 1,
            borderColor: '#cbd5f5',
            borderRadius: 12,
            paddingHorizontal: 16,
            paddingVertical: 14,
            backgroundColor: '#fff',
          }}
        />
        
        {/* 5. FLATLIST (Filtrelenmiş Listeyi Gösterme Alanı) */}
        <FlatList
          data={filteredLessons}                       // DİKKAT: Ham dizi yerine filtrelenmiş dizi (filteredLessons) verilir!
          keyExtractor={(item) => item.id}
          
          // 6. LİSTE BOŞ OLDUĞUNDA GÖSTERİLECEK BİLEŞEN (ListEmptyComponent - Sınav Sorusu!)
          // Eğer aranan kelimeyle eşleşen hiçbir ders kalmazsa bu kutu ve yazı ekranda görünür.
          ListEmptyComponent={
            <View
              style={{
                padding: 16,
                borderRadius: 12,
                backgroundColor: '#e0f2fe',
              }}
            >
              <Text style={{ color: '#1f2937' }}>
                No lessons match your search.
              </Text>
            </View>
          }
          
          // renderItem: Eşleşen her bir ders kartını ekranda çizer
          renderItem={({ item }) => (
            <View
              style={{
                padding: 16,
                borderRadius: 12,
                backgroundColor: '#e0f2fe',
              }}
            >
              <Text style={{ fontWeight: '600', color: '#0f172a' }}>
                {item.title}
              </Text>
            </View>
          )}
          
          ItemSeparatorComponent={() => <View style={{ height: 12 }} />} // Kartlar arası dikey boşluk
          contentContainerStyle={{ paddingBottom: 24 }}
        />
        
      </View>
    </SafeAreaView>
  );
}
