import React, { useState } from 'react';
import { View, Text, TextInput, StyleSheet } from 'react-native';

export default function TextInputExample() {
  
  // 1. STATE (DURUM) TANIMLAMASI
  // text: Kullanıcının klavyeden yazdığı metni saklar (Başlangıçta boş bir string '')
  // setText: Kullanıcı klavyede her harfe bastığında state'i güncelleyen fonksiyondur
  const [text, setText] = useState('');

  return (
    <View style={styles.container}>
      <Text style={styles.title}>Text Input</Text>
      
      {/* 2. METİN GİRİŞ ALANI (TextInput) */}
      <TextInput
        style={styles.input}
        placeholder="Write something..." // Kullanıcı kutu boşken göreceği silik rehber yazı
        value={text}                    // Input'un içindeki değer her zaman 'text' state'ine bağlıdır (Controlled Component)
        onChangeText={setText}          // Kullanıcı her harf yazdığında tetiklenir ve yeni metni state'e kaydeder
      />
      
      {/* 3. ANLIK METİN YANSITMA */}
      {/* Kullanıcının yazdığı metin alt alta anlık olarak ekrana yazdırılır */}
      <Text style={styles.displayText}>
        You wrote: {text}
      </Text>
      
      {/* 4. KARAKTER SAYISI HESAPLAMA */}
      {/* .length metodu ile string'in kaç karakterden oluştuğu anlık olarak gösterilir */}
      <Text style={styles.countText}>
        Character count: {text.length}
      </Text>
    </View>
  );
}

