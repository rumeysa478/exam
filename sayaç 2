// ==========================================

import React, { useState } from 'react';
import { View, Text, TouchableOpacity, StyleSheet } from 'react-native';

export default function DynamicVariableExample() {
  // useState Hook'u ile sayacın anlık değerini tutuyoruz (başlangıç: 0)
  const [count, setCount] = useState(0);
  
  // Sabit (değişmeyecek) konfigürasyon değerleri
  const maxCount = 10;     // Maksimum sınır
  const minCount = 0;      // Minimum sınır
  const stepSize = 1;      // Artış/azalış miktarı
  
  // Anlık duruma bağlı dinamik değişkenler
  let currentCount = count;
  let canIncrement = currentCount < maxCount; // Artırılabilir mi? (10'dan küçükse true)
  let canDecrement = currentCount > minCount; // Azaltılabilir mi? (0'dan büyükse true)
  
  // Hesaplanan değerler
  const progress = (currentCount / maxCount) * 100; // İlerleme yüzdesi hesaplama
  const isComplete = currentCount === maxCount;     // Zirveye ulaşıldı mı? (10 oldu mu?)
  
  // Artırma fonksiyonu (Sınır aşılmadıysa çalışır)
  const increment = () => {
    if (canIncrement) {
      setCount(currentCount + stepSize);
    }
  };
  
  // Azaltma fonksiyonu (Sınır aşılmadıysa çalışır)
  const decrement = () => {
    if (canDecrement) {
      setCount(currentCount - stepSize);
    }
  };
  
  // Sayacı başa döndürme (Reset) fonksiyonu
  const reset = () => {
    setCount(minCount);
  };
  
  return (
    <View style={styles.container}>
      <Text style={styles.title}>Dynamic Variable Example</Text>
      
      {/* Sayaç ve İlerleme Gösterge Kutusu */}
      <View style={styles.counterBox}>
        <Text style={styles.countText}>{currentCount}</Text>
        {/* .toFixed(0) ile ondalıklı kısımlar atılarak tam sayı yüzde yazdırılır */}
        <Text style={styles.progressText}>Progress: %{progress.toFixed(0)}</Text>
      </View>
      
      {/* Kontrol Butonları Satırı */}
      <View style={styles.buttonContainer}>
        {/* Azaltma Butonu: Sınırda ise (!canDecrement) grileşir ve devre dışı kalır */}
        <TouchableOpacity 
          style={[styles.button, !canDecrement && styles.disabledButton]} 
          onPress={decrement}
          disabled={!canDecrement}
        >
          <Text style={styles.buttonText}>-</Text>
        </TouchableOpacity>
        
        {/* Artırma Butonu: Sınırda ise (!canIncrement) grileşir ve devre dışı kalır */}
        <TouchableOpacity 
          style={[styles.button, !canIncrement && styles.disabledButton]} 
          onPress={increment}
          disabled={!canIncrement}
        >
          <Text style={styles.buttonText}>+</Text>
        </TouchableOpacity>
      </View>
      
      {/* Sıfırlama Butonu */}
      <TouchableOpacity style={styles.resetButton} onPress={reset}>
        <Text style={styles.buttonText}>Reset</Text>
      </TouchableOpacity>
      
      {/* Koşullu Render: Zirveye ulaşıldığında kutlama mesajını göster */}
      {isComplete && (
        <Text style={styles.completeText}>🎉 You reached maximum value!</Text>
      )}
      
      {/* Bilgilendirme Alanı */}
      <View style={styles.infoContainer}>
        <Text style={styles.infoText}>Maximum: {maxCount}</Text>
        <Text style={styles.infoText}>Minimum: {minCount}</Text>
        <Text style={styles.infoText}>Step: {stepSize}</Text>
      </View>
    </View>
  );
}

