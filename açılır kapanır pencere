// ==========================================
// FAQItem.js - Açılır-Kapanır Soru/Cevap (Accordion) Örneği
// ==========================================

import { useState } from 'react';
import { SafeAreaView, Text, TouchableOpacity, View } from 'react-native';

// 1. SABİT VERİLER
const QUESTION = 'How do I share my project with Expo?';
const ANSWER =
  'You can either scan the QR code in the Expo Go app or publish the project with the `expo publish` command.';

export default function FAQItem() {
  
  // 2. STATE (DURUM) TANIMLAMASI
  const [expanded, setExpanded] = useState(false); // Soru açık mı kapalı mı? (Başlangıçta false = kapalı)

  return (
    // SafeAreaView: Çentikli ekranlar için güvenli alan sağlar (#f8fafc açık gri arkaplan)
    <SafeAreaView style={{ flex: 1, backgroundColor: '#f8fafc' }}>
      <View
        style={{
          flex: 1,
          justifyContent: 'center',
          padding: 24,
        }}
      >
        {/* Beyaz Kart Konteyneri (Gölge efektleri ile) */}
        <View
          style={{
            borderRadius: 16,
            backgroundColor: '#fff',
            shadowColor: '#000',
            shadowOpacity: 0.04,
            shadowRadius: 12,
            elevation: 2, // Android gölge derinliği
          }}
        >
          {/* 3. TIKLANABİLİR BAŞLIK ALANI (TouchableOpacity) */}
          <TouchableOpacity
            // Tıklandığında expanded değerini tersine çevirir (false -> true, true -> false)
            onPress={() => setExpanded((prev) => !prev)}
            activeOpacity={0.6}
            style={{
              padding: 20,
              flexDirection: 'row',          // Soru metni solda, artı/eksi simgesi sağda yan yana durur
              justifyContent: 'space-between',
              alignItems: 'center',
            }}
          >
            {/* Soru Metni (flex: 1 alandaki tüm boşluğu kaplar) */}
            <Text style={{ fontWeight: '600', flex: 1, fontSize: 16 }}>
              {QUESTION}
            </Text>
            
            {/* 4. DİNAMİK İKON / İŞARET ('+' veya '−') */}
            <Text style={{ color: '#2563eb', marginLeft: 16, fontSize: 18 }}>
              {/* Eğer expanded true ise eksi ('−'), false ise artı ('+') gösterir */}
              {expanded ? '−' : '+'}
            </Text>
          </TouchableOpacity>
          
          {/* 5. KOŞULLU RENDER İLE CEVAP ALANI (Çok Önemli Sınav Konusu!) */}
          {/* Eğer expanded true ise bu View ve içindeki cevap metni ekranda görünür, false ise hiç oluşturulmaz! */}
          {expanded && (
            <View style={{ paddingHorizontal: 20, paddingBottom: 20 }}>
              <Text style={{ color: '#475569', lineHeight: 20 }}>{ANSWER}</Text>
            </View>
          )}
          
        </View>
      </View>
    </SafeAreaView>
  );
}
