// ==========================================
// StateUpdateExample.js - State Güncelleme Kuralları
// ==========================================

import React, { useState } from 'react';
import { View, Text, TouchableOpacity, StyleSheet } from 'react-native';

export default function StateUpdateExample() {
  // Sayaç state'ini tanımlıyoruz (başlangıç değeri 0)
  const [count, setCount] = useState(0);

  // ❌ YANLIŞ YÖNTEM (ASLA YAPILMAZ):
  // State değişkeni doğrudan '=' işaretiyle değiştirilemez. 
  // count = count + 1; -> React bu değişikliği algılayamaz ve ekranı yenilemez!

  // ✅ DOĞRU YÖNTEM 1: Standart kullanım
  const handleDirectUpdate = () => {
    setCount(count + 1); // setCount fonksiyonu kullanılarak değer güncellenir
  };

  // ✅ DAHA İYİ YÖNTEM 2 (Best Practice): Önceki değeri baz alarak güncelleme
  // Özellikle ardışık state güncellemelerinde en güvenli yoldur.
  const handlePrevUpdate = () => {
    setCount(prevCount => prevCount + 1); // prevCount, o anki güncel değeri temsil eder
  };

  return (
    <View style={styles.container}>
      <Text style={styles.title}>State Update Rules</Text>
      <Text style={styles.countText}>Count: {count}</Text>

      {/* Doğru Yöntem Butonu */}
      <TouchableOpacity style={styles.button} onPress={handleDirectUpdate}>
        <Text style={styles.buttonText}>Normal Artır (+1)</Text>
      </TouchableOpacity>

      {/* Daha İyi Yöntem Butonu */}
      <TouchableOpacity style={styles.buttonAlt} onPress={handlePrevUpdate}>
        <Text style={styles.buttonText}>Güvenli Artır (Prev)</Text>
      </TouchableOpacity>
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, padding: 20, justifyContent: 'center', alignItems: 'center' },
  title: { fontSize: 22, fontWeight: 'bold', marginBottom: 20 },
  countText: { fontSize: 36, fontWeight: 'bold', color: '#007AFF', marginBottom: 20 },
  button: { backgroundColor: '#28A745', padding: 15, borderRadius: 8, marginBottom: 10, minWidth: 200, alignItems: 'center' },
  buttonAlt: { backgroundColor: '#007AFF', padding: 15, borderRadius: 8, minWidth: 200, alignItems: 'center' },
  buttonText: { color: 'white', fontSize: 16, fontWeight: '600' },
});

