// ==========================================
// NewsCard.js - Görsel Yüklenme ve Hata Yönetimi Örneği
// ==========================================

import { useState } from 'react';
import {
  ActivityIndicator,
  Image,
  SafeAreaView,
  StyleSheet,
  Text,
  View,
} from 'react-native';

export default function NewsCard() {
  
  // 1. STATE (DURUM) TANIMLAMALARI
  const [loading, setLoading] = useState(true);   // Görselin yüklenme aşamasında olup olmadığını takip eder
  const [error, setError] = useState(false);      // Görsel yüklenirken bir hata oluşup oluşmadığını takip eder

  return (
    // SafeAreaView: İçeriğin telefonun çentik ve kenar boşluklarında kalmasını engeller (#f8fafc açık gri arkaplan)
    <SafeAreaView style={{ flex: 1, backgroundColor: '#f8fafc' }}>
      <View style={{ flex: 1, justifyContent: 'center', padding: 24 }}>
        
        {/* Ana Kart Konteyneri (Beyaz arka plan ve gölge efektleri) */}
        <View
          style={{
            borderRadius: 20,
            backgroundColor: '#fff',
            shadowColor: '#000',
            shadowOpacity: 0.08,
            shadowRadius: 12,
            elevation: 3, // Android gölge derinliği
          }}
        >
          {/* Görsel Alanı (Üst köşeleri yuvarlatılmış ve taşmaları gizleyen alan) */}
          <View
            style={{
              height: 200,
              overflow: 'hidden',
              borderTopLeftRadius: 20,
              borderTopRightRadius: 20,
            }}
          >
            {/* 2. YÜKLENİYOR GÖSTERGESİ (LOADING STATE) */}
            {loading && !error && (
              <View
                style={{
                  ...StyleSheet.absoluteFillObject, // Üstteki View'ı tamamen kaplar (absolute konumlandırma)
                  justifyContent: 'center',
                  alignItems: 'center',
                  backgroundColor: '#e2e8f0',     // Yüklenirken görünecek gri arka plan
                }}
              >
                <ActivityIndicator color="#2563eb" /> {/* Mavi dönen yüklenme çarkı */}
              </View>
            )}
            
            {/* 3. HATA DURUMU (ERROR STATE) */}
            {error && (
              <View
                style={{
                  ...StyleSheet.absoluteFillObject,
                  justifyContent: 'center',
                  alignItems: 'center',
                  backgroundColor: '#e2e8f0',
                }}
              >
                <Text>Image failed to load</Text> {/* Görsel yüklenemezse çıkacak hata yazısı */}
              </View>
            )}
            
            {/* 4. RESİM (IMAGE) BİLEŞENİ */}
            <Image
              source={{ uri: 'https://picsum.photos/600/400' }} // Uzaktan yüklenecek örnek görsel adresi
              style={{ width: '100%', height: '100%' }}
              
              // Resim yüklenmeye başladığında tetiklenir
              onLoadStart={() => {
                setLoading(true);
                setError(false);
              }}
              
              // Resim başarıyla yüklendiğinde tetiklenir
              onLoad={() => setLoading(false)}
              
              // Resim yüklenirken hata oluştuğunda tetiklenir
              onError={() => {
                setLoading(false);
                setError(true);
              }}
            />
          </View>
          
          {/* Kartın Metin İçeriği (Başlık ve Açıklama) */}
          <View style={{ padding: 20, gap: 8 }}>
            <Text style={{ fontSize: 18, fontWeight: '600', color: '#111827' }}>
              New React Native Course Launch
            </Text>
            <Text style={{ color: '#475569', lineHeight: 20 }}>
              The latest series covers everything from core components to performance
              optimization, all built with Expo.
            </Text>
          </View>
          
        </View>
      </View>
    </SafeAreaView>
  );
}
