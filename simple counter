// 1. Gerekli kütüphane ve bileşenleri içe aktarıyoruz
import React, { useState } from 'react';
import { View, Text, TouchableOpacity, StyleSheet } from 'react-native';

export default function SimpleCounter() {
  
  // 2. STATE (DURUM) TANIMLAMASI
  // count: Sayacın o anki değerini tutar (Başlangıç değeri: 0)
  // setCount: Sayacın değerini değiştirmek ve ekranda güncellenmesini sağlamak için kullanılan fonksiyon
  const [count, setCount] = useState(0);

  // 3. ARTIRMA FONKSİYONU
  const increment = () => {
    setCount(count + 1); // Mevcut sayının üzerine 1 ekler ve state'i günceller
  };

  // 4. AZALTMA FONKSİYONU
  const decrement = () => {
    setCount(count - 1); // Mevcut sayıdan 1 çıkarır ve state'i günceller
  };

  // 5. SIFIRLAMA FONKSİYONU
  const reset = () => {
    setCount(0); // Sayacı doğrudan 0'a eşitleer
  };

  // 6. ARAYÜZÜN OLUŞTURULDUĞU YER (JSX Return)
  return (
    <View style={styles.container}>
      
      {/* Bileşen Başlığı */}
      <Text style={styles.title}>Simple Counter</Text>
      
      {/* Anlık Sayaç Değeri (State içindeki count değişkeni ekrana yazdırılıyor) */}
      <Text style={styles.countText}>{count}</Text>
      
      {/* Artırma ve Azaltma Butonlarını Yan Yana Tutan Konteyner */}
      <View style={styles.buttonContainer}>
        
        {/* Azaltma Butonu (-): Tıklandığında decrement fonksiyonunu tetikler */}
        <TouchableOpacity style={styles.button} onPress={decrement}>
          <Text style={styles.buttonText}>-</Text>
        </TouchableOpacity>
        
        {/* Artırma Butonu (+): Tıklandığında increment fonksiyonunu tetikler */}
        <TouchableOpacity style={styles.button} onPress={increment}>
          <Text style={styles.buttonText}>+</Text>
        </TouchableOpacity>
        
      </View>
      
      {/* Sıfırlama Butonu (Reset): Tıklandığında reset fonksiyonunu tetikler */}
      <TouchableOpacity style={styles.resetButton} onPress={reset}>
        <Text style={styles.buttonText}>Reset</Text>
      </TouchableOpacity>
      
    </View>
  );
}

