import { useState } from 'react';
import {
  Alert,
  KeyboardAvoidingView,
  Modal,
  Platform,
  SafeAreaView,
  ScrollView,
  StyleSheet,
  Switch,
  Text,
  TextInput,
  TouchableOpacity,
  View,
} from 'react-native';
import { Ionicons } from '@expo/vector-icons';

export default function ExamAdvancedScreen() {
  
  // 1. STATE (DURUM) TANIMLAMALARI
  const [username, setUsername] = useState('Rumeysa Aydın');
  const [notifications, setNotifications] = useState(true); // Switch durumu
  const [modalVisible, setModalVisible] = useState(false);  // Modal açık/kapalı durumu
  const [tempName, setTempName] = useState('');              // Modal içindeki input değeri

  // 2. ALERT (UYARI) PENCERESİ ÖRNEĞİ
  const handleSaveSettings = () => {
    Alert.alert(
      'Başarılı 🎉',
      'Ayarlarınız başarıyla kaydedildi.',
      [{ text: 'Tamam', onPress: () => console.log('Alert kapatıldı') }]
    );
  };

  return (
    // SafeAreaView: Çentikli ekranlar için güvenli alan sağlar
    <SafeAreaView style={styles.container}>
      
      {/* 3. KEYBOARDAVOIDINGVIEW (Klavye Açıldığında Ekranın Kaymasını Engeller - Hayati Sınav Konusu!) */}
      <KeyboardAvoidingView
        behavior={Platform.OS === 'ios' ? 'padding' : 'height'}
        style={{ flex: 1 }}
      >
        <ScrollView contentContainerStyle={styles.scrollContent}>
          
          {/* ÜST BAŞLIK */}
          <View style={styles.header}>
            <Text style={styles.headerSubtitle}>KULLANICI PANELİ</Text>
            <Text style={styles.headerTitle}>Gelişmiş Ayarlar</Text>
          </View>

          {/* KART 1: PROFİL BİLGİLERİ VE MODAL TETİKLEYİCİ */}
          <View style={styles.card}>
            <View style={styles.rowBetween}>
              <View>
                <Text style={styles.cardLabel}>Profil Adı</Text>
                <Text style={styles.cardValue}>{username}</Text>
              </View>
              
              {/* Modal Açma Butonu */}
              <TouchableOpacity
                onPress={() => {
                  setTempName(username); // Mevcut ismi modal inputuna aktar
                  setModalVisible(true);  // Modalı aç
                }}
                style={styles.smallButton}
              >
                <Text style={styles.smallButtonText}>Düzenle</Text>
              </TouchableOpacity>
            </View>
          </View>

          {/* KART 2: SWITCH (AÇMA/KAPAMA) BİLEŞENİ */}
          <View style={styles.card}>
            <View style={styles.rowBetween}>
              <View style={{ flex: 1, marginRight: 16 }}>
                <Text style={styles.cardLabel}>Bildirimler</Text>
                <Text style={styles.cardDesc}>Yeni dersler eklendiğinde anlık bildirim al.</Text>
              </View>
              
              {/* Switch Bileşeni */}
              <Switch
                value={notifications}
                onValueChange={setNotifications} // Değiştikçe state'i günceller
                trackColor={{ false: '#334155', true: '#0284c7' }} // Arka plan renkleri
                thumbColor={notifications ? '#38bdf8' : '#94a3b8'} // Yuvarlak buton rengi
              />
            </View>
          </View>

          {/* KAYDET BUTONU (Alert Tetikler) */}
          <TouchableOpacity onPress={handleSaveSettings} style={styles.primaryButton}>
            <Text style={styles.primaryButtonText}>Değişiklikleri Kaydet</Text>
          </TouchableOpacity>

        </ScrollView>
      </KeyboardAvoidingView>

      {/* ========================================== */}
      {/* 4. MODAL BİLEŞENİ (Pop-up Pencere) */}
      {/* ========================================== */}
      <Modal
        animationType="slide"          // Aşağıdan yukarıya doğru kayarak açılma animasyonu
        transparent={true}             // Arkasındaki ekranın hafif görünmesi için şeffaf arkaplan
        visible={modalVisible}         // Modal açık mı kapalı mı?
        onRequestClose={() => setModalVisible(false)} // Android Geri tuşuna basıldığında kapanması için
      >
        <View style={styles.modalOverlay}>
          <View style={styles.modalContent}>
            
            <Text style={styles.modalTitle}>İsmi Güncelle</Text>
            
            {/* Modal İçi TextInput */}
            <TextInput
              value={tempName}
              onChangeText={setTempName}
              placeholder="Yeni adınızı girin..."
              placeholderTextColor="#94a3b8"
              style={styles.modalInput}
            />

            {/* Modal Butonları (İptal ve Kaydet) */}
            <View style={styles.modalButtonRow}>
              <TouchableOpacity
                onPress={() => setModalVisible(false)}
                style={styles.cancelButton}
              >
                <Text style={styles.cancelButtonText}>İptal</Text>
              </TouchableOpacity>

              <TouchableOpacity
                onPress={() => {
                  if (tempName.trim() !== '') {
                    setUsername(tempName); // Ana state'i güncelle
                  }
                  setModalVisible(false); // Modalı kapat
                }}
                style={styles.saveButton}
              >
                <Text style={styles.saveButtonText}>Güncelle</Text>
              </TouchableOpacity>
            </View>

          </View>
        </View>
      </Modal>

    </SafeAreaView>
  );
}

